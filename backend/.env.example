# Backend Environment Variables Example
# Copy this file to .env and configure as needed:
# cp .env.example .env

# Allowed CORS origins (comma-separated, typically frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ollama local LLM configuration
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Session secret for OAuth state handling (change to random string in production)
SESSION_SECRET=dev_session_secret_change_me_to_a_random_string

# JWT Secret Key for token signing (REQUIRED: change to secure random string)
JWT_SECRET_KEY=dev_jwt_secret_key_change_me_to_a_random_string

# Google OAuth Credentials (Optional - leave blank if not using Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
